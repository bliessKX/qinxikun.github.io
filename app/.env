# 线上默认配置（提交进仓库，GitHub Actions 构建时读取）。
# 这 4 个值在 Giscus 前端脚本里本来就是明文，不是密钥。
# 本地想覆盖：复制 app/.env.example 为 app/.env.local（Vite 中 .env.local 优先级高于 .env）。

# 关掉留言板：改成 off 后 push，导航 / footer / 第三方脚本一起消失。
VITE_GUESTBOOK_ENABLED=on

VITE_GISCUS_REPO=bliessKX/qinxikun.github.io
VITE_GISCUS_REPO_ID=R_kgDOUiLIzQ
# giscus.app 选定的分类（General）；本站 mapping=specific 固定单帖，分类开放也无乱开帖风险。
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=DIC_kwDOUiLIzc4DLAwS
