# 本地覆盖用：复制为 app/.env.local（不进版本库，优先级高于 app/.env）。
# 线上配置在 app/.env，会提交进仓库供 GitHub Actions 构建读取。
# 关掉留言板（导航/footer/第三方脚本一起消失，站点回到纯静态版本）：
# VITE_GUESTBOOK_ENABLED=off
VITE_GUESTBOOK_ENABLED=on

# 到 https://giscus.app 生成；仓库需先开启 Discussions 并安装 Giscus App。
VITE_GISCUS_REPO=bliessKX/qinxikun.github.io
VITE_GISCUS_REPO_ID=R_kgDOUiLIzQ
# 与 app/.env 保持一致；复制到 .env.local 后直接可用，别留空（空值会覆盖 .env）
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=DIC_kwDOUiLIzc4DLAwS
